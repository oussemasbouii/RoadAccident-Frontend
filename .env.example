# Development-only login bypass (set to true only for local testing)
VITE_DEV_BYPASS_LOGIN=false

# Backend API base URL for local dev with Vite proxy rewrite (/api -> /api/v2)
VITE_API_URL=/api
VITE_SOCKET_BASE_URL=http://localhost:5273
VITE_SOCKET_PATH=/socket.io
VITE_SOCKET_URL=/socket.io
VITE_LIVEKIT_URL=
# Map services (self-hosted via micladevops.com)
VITE_MARTIN_BASE_URL=https://martin.micladevops.com
VITE_MARTIN_TILESET_ID=basemap
VITE_PHOTON_BASE_URL=https://photon.micladevops.com
VITE_VALHALLA_BASE_URL=https://valhalla.micladevops.com
# Optional: override CDN URLs for glyphs/sprites (defaults to tiles.versatiles.org)
VITE_MAP_GLYPHS_URL=https://tiles.versatiles.org/assets/glyphs/{fontstack}/{range}.pbf
VITE_MAP_SPRITE_BASICS_URL=https://tiles.versatiles.org/assets/sprites/basics/sprites
